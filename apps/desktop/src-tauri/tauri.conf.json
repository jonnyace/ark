{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lastbook Next",
  "version": "0.9.0-rc.1",
  "identifier": "org.lastbook.next",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      { "label": "main", "title": "Lastbook Next", "width": 1200, "height": 850, "minWidth": 360, "minHeight": 480 }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data: lbn: http://lbn.localhost",
        "media-src": "'self' blob: lbn: http://lbn.localhost http://127.0.0.1:*",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost lbn: http://lbn.localhost http://127.0.0.1:* blob: data:",
        "worker-src": "'self' blob:",
        "frame-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Education",
    "shortDescription": "Offline knowledge library with optional local AI",
    "longDescription": "Lastbook Next keeps documents, maps, videos and encyclopedias on your computer and works with every network disconnected. An optional local AI answers questions from your library with citations.",
    "license": "MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "resources": { "../../../.dev-cache/runner-bin/": "runner/" },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "gstreamer1.0-plugins-good", "gstreamer1.0-plugins-base", "libgomp1"] }
    }
  }
}
