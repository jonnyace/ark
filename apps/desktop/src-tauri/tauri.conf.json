{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ark",
  "version": "0.9.0-rc.1",
  "identifier": "io.github.jonnyace.ark",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Ark",
        "width": 1200,
        "height": 850,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data: lbn: http://lbn.localhost",
        "media-src": "'self' blob: lbn: http://lbn.localhost http://127.0.0.1:*",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost lbn: http://lbn.localhost http://127.0.0.1:* blob: data:",
        "worker-src": "'self' blob:",
        "frame-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "freezePrototype": true,
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Offline knowledge library with optional local AI",
    "longDescription": "Ark keeps documents, maps, videos and encyclopedias on your computer and works with every network disconnected. An optional local AI answers questions from your library with citations.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../.dev-cache/runner-bin/": "runner/"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-base",
          "libgomp1"
        ],
        "files": {
          "/usr/bin/ark-pack": "../../../.dev-cache/container-target/release/ark-pack",
          "/usr/share/doc/ark-library/LICENSE": "../../../LICENSE",
          "/usr/share/doc/ark-library/NOTICE.md": "../../../NOTICE.md"
        }
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": null,
      "hardenedRuntime": true
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
